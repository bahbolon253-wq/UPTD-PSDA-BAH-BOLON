rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /akun-pengguna/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }

    match /profil/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
    
    match /surat-masuk/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /surat-keluar/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /pegawai/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /keuangan/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /aset/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /daerah-irigasi/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /sungai/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
    
    match /pembangunan/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }
  }
}
