rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /profil/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId);
    }
    
    match /surat-masuk/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /surat-keluar/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /pegawai/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /keuangan/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /aset/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /daerah-irigasi/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
    
    match /pembangunan/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }
  }
}
